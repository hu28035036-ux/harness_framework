generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkerApprovalStatus {
  pending
  approved
  rejected
  suspended
}

enum WorkSessionStatus {
  draft
  recording_start
  in_progress
  paused
  held
  resumed
  completed
  cancelled
  deleted
}

enum VerificationPostStatus {
  draft
  assets_uploading
  ready_to_publish
  published
  rating_pending
  rated
  deleted
}

enum AssetStatus {
  none
  recording
  uploading
  uploaded
  failed
  local_saved
  retry_pending
}

enum WantedPostStatus {
  open
  closed
  hidden
  deleted
}

enum ReportStatus {
  received
  reviewing
  listed
  rejected
  closed
}

model User {
  id              String    @id @default(cuid())
  roleFlags       String[]
  nickname        String    @unique
  email           String    @unique
  phone           String?
  realName        String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  status          String    @default("active")

  workerProfile      WorkerProfile?
  wantedPosts        WantedPost[]
  scammerReports     ScammerReport[]

  @@map("users")
}

model WorkerProfile {
  userId          String   @id
  workerName      String
  characterName   String
  intro           String
  jobs            String[]
  huntingAreas    String[]
  availableTime   String
  priceText       String
  openKakaoUrl    String?
  discordContact  String?
  approvalStatus  WorkerApprovalStatus @default(pending)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id])
  portfolioItems   PortfolioItem[]
  promoPosts       PromoPost[]
  wantedComments   WantedPostComment[]
  workSessions     WorkSession[]
  verificationPosts VerificationPost[]

  @@map("worker_profiles")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  workerId    String
  title       String
  description String
  mediaUrls   String[]
  createdAt   DateTime @default(now())

  worker WorkerProfile @relation(fields: [workerId], references: [userId])

  @@map("portfolio_items")
}

model PromoPost {
  id          String   @id @default(cuid())
  workerId    String
  title       String
  huntingArea String
  content     String
  createdAt   DateTime @default(now())
  status      String   @default("published")

  worker WorkerProfile @relation(fields: [workerId], references: [userId])

  @@map("promo_posts")
}

model WantedPost {
  id                 String           @id @default(cuid())
  customerId         String
  title              String
  huntingArea        String
  levelCondition     String
  desiredDuration    Int
  desiredStartTime   DateTime?
  desiredPrice       String?
  authMethod         String
  contactMethod      String
  memo               String?
  status             WantedPostStatus @default(open)
  createdAt          DateTime         @default(now())

  customer User                @relation(fields: [customerId], references: [id])
  comments WantedPostComment[]

  @@map("wanted_posts")
}

model WantedPostComment {
  id            String   @id @default(cuid())
  wantedPostId  String
  workerId      String
  content       String
  availableTime String
  authMethod    String
  createdAt     DateTime @default(now())
  status        String   @default("published")

  wantedPost WantedPost    @relation(fields: [wantedPostId], references: [id])
  worker     WorkerProfile @relation(fields: [workerId], references: [userId])

  @@map("wanted_post_comments")
}

model WorkSession {
  id               String            @id @default(cuid())
  workerId         String
  customerNickname String
  huntingArea      String
  plannedDuration  Int
  mode             String
  status           WorkSessionStatus @default(draft)
  startedAt        DateTime?
  completedAt      DateTime?
  pausedSeconds    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  worker            WorkerProfile     @relation(fields: [workerId], references: [userId])
  verificationPost  VerificationPost?
  captures          Capture[]
  clips             Clip[]

  @@map("work_sessions")
}

model VerificationPost {
  id                String                 @id @default(cuid())
  sessionId         String                 @unique
  workerId          String
  title             String
  summary           String
  priceText         String
  memo              String?
  status            VerificationPostStatus @default(draft)
  publishedAt       DateTime?
  customerLinkToken String?                @unique

  session WorkSession   @relation(fields: [sessionId], references: [id])
  worker  WorkerProfile @relation(fields: [workerId], references: [userId])
  captures Capture[]
  clips    Clip[]
  ratings  Rating[]

  @@map("verification_posts")
}

model Capture {
  id               String      @id @default(cuid())
  sessionId        String
  postId           String?
  type             String
  fileUrl          String
  capturedAt       DateTime
  uploadedAt       DateTime?
  sha256Hash       String
  isRepresentative Boolean     @default(false)
  status           AssetStatus @default(local_saved)

  session WorkSession       @relation(fields: [sessionId], references: [id])
  post    VerificationPost? @relation(fields: [postId], references: [id])

  @@map("captures")
}

model Clip {
  id          String      @id @default(cuid())
  sessionId   String
  postId      String?
  clipType    String
  engine      String
  targetType  String
  durationSec Int
  fileUrl     String
  fileSize    Int
  sha256Hash  String
  status      AssetStatus @default(local_saved)

  session WorkSession       @relation(fields: [sessionId], references: [id])
  post    VerificationPost? @relation(fields: [postId], references: [id])

  @@map("clips")
}

model Rating {
  id             String   @id @default(cuid())
  postId         String
  customerToken  String
  score          Int
  reason         String?
  publicReview   String?
  createdAt      DateTime @default(now())
  submitIpHash   String

  post VerificationPost @relation(fields: [postId], references: [id])

  @@unique([postId, customerToken])
  @@map("ratings")
}

model ScammerReport {
  id           String       @id @default(cuid())
  reporterId   String
  targetText   String
  reason       String
  evidenceUrls String[]
  status       ReportStatus @default(received)
  createdAt    DateTime     @default(now())

  reporter User @relation(fields: [reporterId], references: [id])

  @@map("scammer_reports")
}

model ScammerEntry {
  id            String       @id @default(cuid())
  displayName   String
  characterName String?
  reasonType    String
  description   String
  status        ReportStatus @default(listed)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("scammer_entries")
}

model UpdateVersion {
  version        String   @id
  minimumVersion String
  forceUpdate    Boolean  @default(false)
  downloadUrl    String
  releaseNotes   String[]
  createdAt      DateTime @default(now())

  @@map("update_versions")
}
